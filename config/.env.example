# Export locally; this app does not automatically load .env files.
# Supply your own values. No working credentials are included.
FLASK_SECRET_KEY=
OIDC_CLIENT_ID=flask-corp-app
OIDC_CLIENT_SECRET=
OIDC_DISCOVERY_URL=https://keycloak.example.invalid/realms/corp/.well-known/openid-configuration
DB_HOST=127.0.0.1
DB_NAME=corp_data
DB_USER=app_user
DB_PASSWORD=
# HTTPS cookies by default. Set to 1 only for the isolated loopback HTTP lab.
LAB_HTTP_ONLY=0
